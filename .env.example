# Honk — Environment Variables
#
# PREFERRED: Copy this to %USERPROFILE%\.claude\honk.env (Windows) or
#            ~/.claude/honk.env (macOS/Linux). This location survives
#            plugin reinstalls and is auto-loaded by honk-server/run.js
#            (~/.claude/spmc.env is still read as a transition fallback).
#
# FALLBACK:  Copy to honk-server/.env for local dev.
# NEVER commit either file.

# ── X (Twitter) — OAuth 1.0a ─────────────────────────────────────────────
# Create an app at developer.twitter.com and generate access tokens.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Instagram / Facebook — Meta Graph API ────────────────────────────────
# One system-user EAA token covers both. Meta Business Suite > System Users >
# Generate token. Required scopes BY CAPABILITY (a missing scope doesn't block
# publishing — the dependent step fails soft and is reported, the post stays live):
#   • Publish (IG/FB):         pages_manage_posts (+ instagram_basic, instagram_content_publish)
#   • First comment on IG:     instagram_manage_comments
#   • First comment on FB Page: pages_manage_engagement
#   • Image alt text:          covered by the publish scopes (no extra) — IG verified;
#                              FB alt_text_custom UNVERIFIED (did not read back in live test)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# ── TikTok — Content Posting API ─────────────────────────────────────────
# Requires OAuth user-authorization flow (see TikTok Developer Portal).
# Token needs the video.publish scope.
TIKTOK_ACCESS_TOKEN=

# ── Threads — Threads API ────────────────────────────────────────────────
# Threads API (threads_basic + threads_content_publish scopes).
# Same Meta app infrastructure as Instagram but a separate token.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── Bluesky — AT Protocol ────────────────────────────────────────────────
# No OAuth — just an app password (never your real account password).
# Generate at: https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# ── Media pipeline — CDN upload (for Instagram / TikTok local files) ─────
# Auto-selected for images: imgbb first (free/unlimited), Cloudinary fallback.
# Video uploads always use Cloudinary (imgbb is images-only).

# Cloudinary — get from cloudinary.com/console. Use EITHER the three discrete
# vars below, OR the single CLOUDINARY_URL one-liner (the dashboard shows both).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# imgbb — get from api.imgbb.com
IMGBB_API_KEY=

# ── Operational settings ─────────────────────────────────────────────────
# Runtime state (brand kit, audit log, analytics) defaults to ~/.honk.
# Override only if you need a non-standard location (e.g. shared install).
# HONK_DATA_DIR=/custom/path/to/honk-data
#
# Timeout for every outbound platform/API call, in milliseconds (default
# 30000). Raise it for slow video uploads; every adapter honours it.
# HONK_HTTP_TIMEOUT_MS=30000

# ── Multi-account support ────────────────────────────────────────────────
# PREFIX any credential key with ACCOUNTNAME__ (uppercase) to define a named
# account. Pass account: "brand" to any publishing tool to use it.
# The default (unprefixed) credentials are a separate account, not a fallback —
# a named account resolves ONLY its own ACCOUNTNAME__ keys.
#
# Example: a second X account named "brand"
BRAND__X_API_KEY=
BRAND__X_API_SECRET=
BRAND__X_ACCESS_TOKEN=
BRAND__X_ACCESS_TOKEN_SECRET=
#
# Example: a second Instagram/Facebook account named "brand"
BRAND__INSTAGRAM_USER_ID=
BRAND__INSTAGRAM_ACCESS_TOKEN=
BRAND__FACEBOOK_PAGE_ID=
BRAND__FACEBOOK_ACCESS_TOKEN=
#
# Example: a second TikTok account named "brand"
BRAND__TIKTOK_ACCESS_TOKEN=
#
# Example: a second Threads account named "brand"
BRAND__THREADS_USER_ID=
BRAND__THREADS_ACCESS_TOKEN=
#
# Example: a second Bluesky account named "brand"
BRAND__BLUESKY_IDENTIFIER=brandbsky.bsky.social
BRAND__BLUESKY_APP_PASSWORD=
