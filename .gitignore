node_modules/
.env
*.env
!.env.example
# Runtime state lives in ~/.honk at runtime; these repo paths only catch
# local-dev leftovers. brand.json is kept as a committed GENERIC sample.
honk-server/queue/queue.json
honk-server/data/
!honk-server/data/brand.json
*.log
.DS_Store

# TypeScript compiled artifacts — generated by tsc, not source-controlled
# (honk-server/src/*.ts are the sources; compiled .js land at the same paths
#  as the former hand-written .js files and are committed; .d.ts are noise)
honk-server/**/*.d.ts
honk-server/**/*.d.ts.map
honk-server/**/*.js.map

# npm pack output (pack:smoke leftover if cleanup is blocked)
*.tgz
