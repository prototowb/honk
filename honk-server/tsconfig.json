{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": ".",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "paths": {
      "sharp": ["./node_modules/sharp/lib/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test"]
}
