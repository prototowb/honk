# Generated build artifacts are emitted with LF — keep them LF in the working
# tree so `npm run build:check` never reports spurious drift from CRLF conversion.
TOOLS.md                     text eol=lf
.claude-plugin/plugin.json   text eol=lf
build/*.mjs                  text eol=lf
# README and the agent CONTEXT carry a generator-injected tool table region
# (between the gen:tools markers); the generator rewrites the whole file as LF.
README.md                    text eol=lf
agent/CONTEXT.md             text eol=lf
# MCP server configs — all three rendered from one template in generate.mjs.
.mcp.json                    text eol=lf
agent/mcp-config.json        text eol=lf
claude_desktop_config.json   text eol=lf
# Generated skills (from capabilities/skills/) + the agent skill-trigger doc
# (from capabilities/agent/SKILLS.md) — same LF rule.
skills/**/SKILL.md           text eol=lf
agent/SKILLS.md              text eol=lf
# Pre-commit hook is a POSIX shell script — must stay LF or a CRLF shebang
# breaks it ("bad interpreter") on Linux/macOS clones.
.githooks/pre-commit         text eol=lf
# honk-server sources and tsc-emitted build artifacts: tsc emits LF, so pin LF
# in the repo regardless of a contributor's core.autocrlf. Without this, blobs
# committed with CRLF show as perpetually "modified" under autocrlf=true even
# when the working-tree bytes are identical (clean filter normalizes to LF, the
# CRLF blob doesn't match). Same generated-artifact rationale as the rules above.
honk-server/**/*.js          text eol=lf
honk-server/**/*.ts          text eol=lf
honk-server/**/*.mjs         text eol=lf
honk-server/**/*.json        text eol=lf
